		LEFT JOIN "Table1_Table2_Ones" AS "entity5" ON (("entity4"."table1Id"="entity5"."relTable1Id") AND ("entity4"."table2Id"="entity5"."relTable2Id"))
		WHERE ("entity5"."number">1)
	) AS "entity4" ON (("entity4"."table1Id"="entity6"."relTable1Id") AND ("entity4"."table2Id"="entity6"."relTable2Id"))
) AS "entity6" ON (("entity0"."table1Id"="entity6"."table1Id") AND ("entity0"."table2Id"="entity6"."table2Id"))
LEFT JOIN "Table1_Table2_Ones" AS "entity3" ON (("entity0"."table1Id"="entity3"."relTable1Id") AND ("entity0"."table2Id"="entity3"."relTable2Id"))
GROUP BY STRFTIME('%d', "entity1"."dateTime"), "entity2"."t2Number", "entity0"."table1Id", "entity0"."table2Id"
ORDER BY STRFTIME('%d', "entity1"."dateTime") ASC, "entity2"."t2Number" ASC, "entity0"."table1Id" ASC, "entity0"."table2Id" ASC"
,
