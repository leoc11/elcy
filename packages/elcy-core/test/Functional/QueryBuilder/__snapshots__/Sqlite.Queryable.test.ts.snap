		"entity2"."modifiedDate"
	FROM "fixture"."Table1s" AS "entity2"
	WHERE ("entity2"."deleted"=false)
) AS "entity2" ON ("entity0"."table1Id"="entity2"."id")
LEFT JOIN (
	SELECT "entity6"."table1Id",
		STRING_AGG("entity6"."t3Name", ',') AS "column4"
	FROM (
