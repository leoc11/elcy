exports[`Sqlite QUERYABLE ARRAY PARAMETER should work in select (Count SubQuery) 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"SELECT "entity0"."id",
	"entity0"."decimalNumber" AS "column0",
	"entity2"."column2" AS "column3"
FROM "fixture"."Table1s" AS "entity0"
LEFT JOIN (
	SELECT "entity2"."id",
		SUM("entity1"."column1") AS "column2"
	FROM "fixture"."Table1s" AS "entity2"
	LEFT JOIN (
		SELECT "entity1"."decimalNumber",
			COUNT("entity1"."__index") AS "column1"
		FROM (
			SELECT
				column1 AS "__index", column2 AS "id", column3 AS "decimalNumber", column4 AS "computed"
			FROM (
				VALUES
				(0, 1234567890, 13200, NULL),
				(1, 1234567891, 71000, NULL)
			)
		) AS "entity1"
		GROUP BY "entity1"."decimalNumber"
	) AS "entity1" ON ("entity2"."decimalNumber">="entity1"."decimalNumber")
	WHERE ("entity2"."deleted"=false)
	GROUP BY "entity2"."id"
) AS "entity2" ON ("entity2"."id"="entity0"."id")
WHERE ("entity0"."deleted"=false)
ORDER BY "entity0"."decimalNumber" ASC"
,
    "type": 1,
  },
]
`;

exports[`Sqlite QUERYABLE ARRAY PARAMETER should work in select (Sum SubQuery) 1`] = `
[
  {
    "parameters": 
Map {
      ":param0" => 0,
      ":param1" => 10,
    }
,
    "query": 
"SELECT "entity0"."id",
	"entity0"."id" AS "column0",
	"entity0"."decimalNumber" AS "column1",
	"entity2"."column3" AS "column4"
FROM "fixture"."Table1s" AS "entity0"
LEFT JOIN (
	SELECT "entity2"."id",
		SUM("entity1"."column2") AS "column3"
	FROM "fixture"."Table1s" AS "entity2"
	LEFT JOIN (
		SELECT "entity1"."dateTime",
			SUM("entity1"."decimalNumber") AS "column2"
		FROM (
			SELECT
				column1 AS "__index", column2 AS "id", column3 AS "dateTime", column4 AS "decimalNumber", column5 AS "computed"
			FROM (
				VALUES
				(0, 1234567890, '2017-02-22 23:03:39.447', 13200, NULL),
				(1, 1234567891, '2017-01-19 02:08:41.530', 71000, NULL)
			)
		) AS "entity1"
		GROUP BY "entity1"."dateTime"
	) AS "entity1" ON ("entity1"."dateTime">="entity2"."dateTime")
	WHERE ("entity2"."deleted"=false)
	GROUP BY "entity2"."id"
) AS "entity2" ON ("entity2"."id"="entity0"."id")
WHERE ("entity0"."deleted"=false)
ORDER BY "entity0"."dateTime" DESC
LIMIT :param1
OFFSET :param0"
,
    "type": 1,
  },
]
`;

exports[`Sqlite QUERYABLE ARRAY PARAMETER should work in select (Some SubQuery) 1`] = `
