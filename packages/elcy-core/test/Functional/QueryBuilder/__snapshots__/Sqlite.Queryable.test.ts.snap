exports[`Sqlite QUERYABLE MAP should select array with where in property 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"SELECT "entity2"."id",
	"entity2"."table1Id",
	"entity2"."name",
	"entity2"."integer",
	"entity2"."deleted"
FROM "Table1Manies" AS "entity2"
INNER JOIN (
	SELECT "entity0"."id",
		(COALESCE("entity1"."column0", 0)) AS "column1"
	FROM "fixture"."Table1s" AS "entity0"
	LEFT JOIN (
		SELECT "entity1"."table1Id",
			SUM("entity1"."integer") AS "column0"
		FROM "Table1Manies" AS "entity1"
		WHERE (("entity1"."deleted"=false) AND ("entity1"."integer">2))
		GROUP BY "entity1"."table1Id"
	) AS "entity1" ON ("entity0"."id"="entity1"."table1Id")
	WHERE ("entity0"."deleted"=false)
) AS "entity0" ON ("entity0"."id"="entity2"."table1Id")
WHERE (("entity2"."deleted"=false) AND ("entity2"."integer"<=1))
ORDER BY "entity2"."table1Id" ASC"
,
    "type": 1,
  },
  {
    "parameters": Map {},
    "query": 
"SELECT "entity0"."id",
	(COALESCE("entity1"."column0", 0)) AS "column1"
FROM "fixture"."Table1s" AS "entity0"
LEFT JOIN (
	SELECT "entity1"."table1Id",
		SUM("entity1"."integer") AS "column0"
	FROM "Table1Manies" AS "entity1"
	WHERE (("entity1"."deleted"=false) AND ("entity1"."integer">2))
	GROUP BY "entity1"."table1Id"
) AS "entity1" ON ("entity0"."id"="entity1"."table1Id")
WHERE ("entity0"."deleted"=false)"
,
    "type": 1,
  },
]
`;

