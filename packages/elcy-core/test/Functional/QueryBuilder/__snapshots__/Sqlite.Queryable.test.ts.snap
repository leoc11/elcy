			) AS "entity3" ON ("entity3"."column3"="entity5"."table2Id")
		) AS "entity5" ON ("entity5"."table3Id"="entity6"."id")
		UNION ALL
		SELECT "entity9"."id",
			"entity9"."t3Name",
			"entity8"."table1Id"
		FROM "fixture"."Table3s" AS "entity9"
		INNER JOIN "Table1_Table3s" AS "entity8" ON ("entity8"."table3Id"="entity9"."id")
	) AS "entity6"
	GROUP BY "entity6"."table1Id"
) AS "entity6" ON ("entity2"."id" IS "entity6"."table1Id")
