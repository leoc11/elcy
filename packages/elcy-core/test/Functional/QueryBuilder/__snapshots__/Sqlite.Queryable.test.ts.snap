	FROM "fixture"."Table1s" AS "entity2"
	LEFT JOIN (
		SELECT "entity1"."decimalNumber",
			true AS "column1"
		FROM (
			SELECT
				column1 AS "__index", column2 AS "id", column3 AS "dateTime", column4 AS "decimalNumber", column5 AS "computed"
			FROM (
				VALUES
				(0, 1234567890, '2017-02-22 23:03:39.447', 13200, NULL),
				(1, 1234567891, '2017-01-19 02:08:41.530', 71000, NULL)
			)
		) AS "entity1"
		GROUP BY "entity1"."decimalNumber"
	) AS "entity1" ON ("entity2"."decimalNumber">"entity1"."decimalNumber")
	WHERE ("entity2"."deleted"=false)
	GROUP BY "entity2"."id"
) AS "entity2" ON ("entity2"."id"="entity0"."id")
WHERE ("entity0"."deleted"=false)
ORDER BY "entity0"."decimalNumber" ASC
LIMIT :param1
OFFSET :param0"
,
