	FROM "fixture"."Table1s" AS "entity2"
	LEFT JOIN (
		SELECT "entity1"."integer",
			COUNT("entity1"."id") AS "column1"
		FROM "fixture"."Table1s" AS "entity1"
		WHERE ("entity1"."deleted"=false)
		GROUP BY "entity1"."integer"
	) AS "entity1" ON ("entity2"."integer">="entity1"."integer")
	WHERE ("entity2"."deleted"=false)
	GROUP BY "entity2"."id"
) AS "entity2" ON ("entity2"."id"="entity0"."id")
WHERE ("entity0"."deleted"=false)
ORDER BY "entity0"."integer" ASC"
