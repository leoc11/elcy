      "param1" => 100,
    }
,
    "query": 
"SELECT CHAR_LENGTH("entity1"."name") AS "column0",
	COUNT("entity1"."table1Id") AS "column1",
	SUM("entity4"."real") AS "column2"
FROM "Table1One" AS "entity1"
INNER JOIN (
	SELECT "entity0"."id",
		"entity0"."bigint",
		"entity0"."binary",
		"entity0"."boolean",
		"entity0"."date",
		"entity0"."plainDate",
		"entity0"."dateTime",
		"entity0"."instant",
		"entity0"."decimal",
		"entity0"."decimalNumber",
		"entity0"."decimalDecimal",
		"entity0"."deleted",
		"entity0"."identifier",
		"entity0"."identifierString",
		"entity0"."integer",
		"entity0"."real",
		"entity0"."string",
		"entity0"."time",
		"entity0"."plainTime",
		"entity0"."createdDate",
		"entity0"."modifiedDate"
	FROM SELECT "entity0"."id",
		"entity0"."bigint",
		"entity0"."binary",
		"entity0"."boolean",
		"entity0"."date",
		"entity0"."plainDate",
		"entity0"."dateTime",
		"entity0"."instant",
		"entity0"."decimal",
		"entity0"."decimalNumber",
		"entity0"."decimalDecimal",
		"entity0"."deleted",
		"entity0"."identifier",
		"entity0"."identifierString",
		"entity0"."integer",
		"entity0"."real",
		"entity0"."string",
		"entity0"."time",
		"entity0"."plainTime",
		"entity0"."createdDate",
		"entity0"."modifiedDate"
	FROM "fixture"."Table1s" AS "entity0"
	WHERE ("entity0"."deleted"=false)
	ORDER BY (SELECT NULL)
	OFFSET $1 ROWS
	FETCH NEXT $2 ROWS ONLY AS "entity0"
	WHERE (("entity0"."integer"+"entity0"."decimalNumber")>10000)
) AS "entity0" ON ("entity0"."id"="entity1"."table1Id")
LEFT JOIN (
	SELECT "entity4"."id",
		"entity2"."table1Id",
		"entity4"."real"
	FROM "fixture"."Table1s" AS "entity4"
	INNER JOIN (
		SELECT "entity2"."table1Id",
			"entity2"."name",
			"entity2"."number"
		FROM "Table1One" AS "entity2"
		LEFT JOIN (
			SELECT "entity3"."id",
				"entity3"."bigint",
				"entity3"."binary",
				"entity3"."boolean",
				"entity3"."date",
				"entity3"."plainDate",
				"entity3"."dateTime",
				"entity3"."instant",
				"entity3"."decimal",
				"entity3"."decimalNumber",
				"entity3"."decimalDecimal",
				"entity3"."deleted",
				"entity3"."identifier",
				"entity3"."identifierString",
				"entity3"."integer",
				"entity3"."real",
				"entity3"."string",
				"entity3"."time",
				"entity3"."plainTime",
				"entity3"."createdDate",
				"entity3"."modifiedDate"
			FROM "fixture"."Table1s" AS "entity3"
			WHERE ("entity3"."deleted"=false)
		) AS "entity3" ON ("entity2"."table1Id"="entity3"."id")
		WHERE ("entity3"."real"<10000)
	) AS "entity2" ON ("entity2"."table1Id"="entity4"."id")
	WHERE ("entity4"."deleted"=false)
) AS "entity4" ON ("entity1"."table1Id"="entity4"."table1Id")
GROUP BY CHAR_LENGTH("entity1"."name")
ORDER BY CHAR_LENGTH("entity1"."name") ASC"
,
    "type": 1,
  },
]
`;

