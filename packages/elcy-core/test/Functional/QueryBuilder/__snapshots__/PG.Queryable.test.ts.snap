exports[`Postgresql QUERYABLE MAP should support self select 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"SELECT "entity2"."table1Id",
	"entity2"."table2Id",
	"entity2"."option12"
FROM "Table1_Table2s" AS "entity2"
INNER JOIN (
	SELECT "entity1"."table1Id",
		"entity1"."table2Id",
		"entity3"."rowVersion" AS "column0"
	FROM "Table1_Table2s" AS "entity1"
	LEFT JOIN "fixture"."Table2s" AS "entity3" ON ("entity1"."table2Id"="entity3"."id")
	INNER JOIN (
		SELECT "entity0"."id"
		FROM "fixture"."Table1s" AS "entity0"
		WHERE ("entity0"."deleted"=false)
	) AS "entity0" ON ("entity0"."id"="entity1"."table1Id")
	ORDER BY "entity1"."table1Id" ASC
) AS "entity1" ON (("entity2"."table1Id"="entity1"."table1Id") AND ("entity2"."table2Id"="entity1"."table2Id"))
ORDER BY "entity2"."table1Id" ASC, "entity2"."table2Id" ASC"
,
    "type": 1,
  },
  {
    "parameters": Map {},
    "query": 
"SELECT "entity1"."table1Id",
	"entity1"."table2Id",
	"entity3"."rowVersion" AS "column0"
FROM "Table1_Table2s" AS "entity1"
LEFT JOIN "fixture"."Table2s" AS "entity3" ON ("entity1"."table2Id"="entity3"."id")
INNER JOIN (
	SELECT "entity0"."id"
	FROM "fixture"."Table1s" AS "entity0"
	WHERE ("entity0"."deleted"=false)
) AS "entity0" ON ("entity0"."id"="entity1"."table1Id")
