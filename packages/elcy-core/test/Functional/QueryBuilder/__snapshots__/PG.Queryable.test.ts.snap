	(
	CASE WHEN (("entity2"."column2"=1)) 
	THEN true
	ELSE false
	END
) AS "column3"
FROM "fixture"."Table1s" AS "entity0"
LEFT JOIN (
	SELECT "entity2"."id",
		(
		CASE WHEN ((SUM("entity1"."column1") IS NOT NULL)) 
		THEN true
		ELSE false
		END
	) AS "column2"
	FROM "fixture"."Table1s" AS "entity2"
	LEFT JOIN (
		SELECT "entity1"."decimalNumber",
			true AS "column1"
		FROM "fixture"."Table1s" AS "entity1"
		WHERE ("entity1"."deleted"=false)
		GROUP BY "entity1"."decimalNumber"
	) AS "entity1" ON ("entity2"."decimalNumber">"entity1"."decimalNumber")
	WHERE ("entity2"."deleted"=false)
	GROUP BY "entity2"."id"
) AS "entity2" ON ("entity2"."id"="entity0"."id")
WHERE ("entity0"."deleted"=false)
ORDER BY "entity0"."decimalNumber" ASC
OFFSET $1 ROWS
FETCH NEXT $2 ROWS ONLY"
,
    "type": 1,
  },
]
`;

