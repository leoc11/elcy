exports[`Mysql DATA MANIPULATION UPDATE should update with VERSION concurrency check 1`] = `
[
  BatchedQuery {
    "_isProcessed": true,
    "_parameters": 
Map {
      "?0" => "Updated",
      "?1" => 1,
      "?2" => Uint8Array [
        1,
        200,
        0,
        0,
        100,
      ],
      "?3" => 1,
      "?4" => Uint8Array [
        1,
        200,
        0,
        0,
        100,
      ],
    }
,
    "_queries": [
      {
        "parameters": 
Map {
          "?0" => "Updated",
          "?1" => 1,
          "?2" => Uint8Array [
            1,
            200,
            0,
            0,
            100,
          ],
        }
,
        "query": 
"UPDATE "fixture"."Table2s" AS "entity0"
SET "entity0"."t2Name" = ?
WHERE (("entity0"."id"=?) AND ("entity0"."rowVersion"=?))"
,
        "type": 2,
      },
      {
        "parameters": 
Map {
          "?0" => 1,
          "?1" => Uint8Array [
            1,
            200,
            0,
            0,
            100,
          ],
        }
,
        "query": 
"SELECT "entity0"."id",
	"entity0"."rowVersion",
	"entity0"."id",
	"entity0"."rowVersion"
FROM "fixture"."Table2s" AS "entity0"
WHERE (("entity0"."id"=?) AND ("entity0"."rowVersion"=?))"
,
        "type": 1,
      },
    ],
    "_query": 
"UPDATE "fixture"."Table2s" AS "entity0"
SET "entity0"."t2Name" = ?
WHERE (("entity0"."id"=?) AND ("entity0"."rowVersion"=?));

SELECT "entity0"."id",
	"entity0"."rowVersion",
	"entity0"."id",
	"entity0"."rowVersion"
FROM "fixture"."Table2s" AS "entity0"
WHERE (("entity0"."id"=?) AND ("entity0"."rowVersion"=?))"
,
    "_type": 3,
  },
]
`;

exports[`Mysql DATA MANIPULATION UPDATE should update with VERSION concurrency check (fallback to ModifiedDate) 1`] = `
