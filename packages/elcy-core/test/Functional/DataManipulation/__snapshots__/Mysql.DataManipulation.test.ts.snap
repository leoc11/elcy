exports[`Mysql DATA MANIPULATION UPDATE should bulk update entity with paging 1`] = `
[
  {
    "parameters": 
Map {
      "?0" => 100,
      "?1" => 99.99,
      "?2" => 99.99,
      "?3" => 100,
      "?4" => 50,
    }
,
    "query": 
"UPDATE "fixture"."Table1s" AS "entity0"
INNER JOIN (
	SELECT "entity0"."id"
	FROM "fixture"."Table1s" AS "entity0"
	WHERE (("entity0"."deleted"=false) AND ((("entity0"."integer">?) AND ("entity0"."real" IS NOT DISTINCT FROM ?)) AND ((COALESCE("entity0"."real", 0))=?)))
	ORDER BY "entity0"."id"
	OFFSET ? ROWS
	FETCH NEXT ? ROWS ONLY
) AS "entity0_1" ON ("entity0"."id"="entity0_1"."id")
SET "id" = "entity0_1"."id""
,
    "type": 2,
  },
]
`;

