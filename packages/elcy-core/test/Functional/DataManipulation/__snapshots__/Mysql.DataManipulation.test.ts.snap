	LIMIT ? OFFSET ?
) AS \`entity0_1\` ON (\`entity0\`.\`id\`=\`entity0_1\`.\`id\`)
SET \`entity0\`.\`string\` = ?,
	\`entity0\`.\`real\` = (\`entity0\`.\`real\`+?)"
,
