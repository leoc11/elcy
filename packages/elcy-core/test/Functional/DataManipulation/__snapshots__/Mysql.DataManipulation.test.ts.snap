exports[`Mysql DATA MANIPULATION INSERT should bulk insert 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"INSERT INTO \`Table1Manies\` (\`name\`)
SELECT (CONCAT('Detail of parent ', CAST(\`entity0\`.\`id\` AS nvarchar(max)))) AS \`column1\`
FROM \`fixture\`.\`Table1s\` AS \`entity0\`
LEFT JOIN (
	SELECT \`entity1\`.\`table1Id\`,
		COUNT(\`entity1\`.*) AS \`column0\`
	FROM \`Table1Manies\` AS \`entity1\`
	WHERE (\`entity1\`.\`deleted\`=false)
	GROUP BY \`entity1\`.\`table1Id\`
) AS \`entity1\` ON (\`entity0\`.\`id\`=\`entity1\`.\`table1Id\`)
WHERE ((\`entity0\`.\`deleted\`=false) AND ((COALESCE(\`entity1\`.\`column0\`, 0))<=0))"
,
    "type": 2,
  },
]
`;

