WHERE (("entity0"."id"=?) AND ("entity0"."modifiedDate"=?))"
,
        "type": 1,
      },
    ],
    "_query": 
"UPDATE "fixture"."Table1s" AS "entity0"
SET "entity0"."string" = ?, "entity0"."modifiedDate" = CURRENT_TIMESTAMP AT TIME ZONE 'UTC'
