exports[`Mysql DATA MANIPULATION SAVE should unblock insert unique constraint hard delete: set null 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"UPDATE \`Unblock\` AS \`entity0\`
INNER JOIN (
	SELECT 10 AS \`_ori_id\`, NULL AS \`unique\`, 1 AS \`__flag\`
) AS \`update\` ON (\`entity0\`.\`id\`=\`update\`.\`_ori_id\`)
SET \`entity0\`.\`unique\` = (
	CASE WHEN (((\`update\`.\`__flag\`&1)=0)) 
	THEN \`entity0\`.\`unique\`
	ELSE \`update\`.\`unique\`
	END
)"
,
    "type": 2,
  },
  BatchedQuery {
    "_isProcessed": true,
    "_parameters": 
Map {
      "?0" => 11n,
      "?1" => 0n,
      "?2" => "new",
      "?3" => 11n,
    }
,
    "_queries": [
      {
        "parameters": 
Map {
          "?0" => 11n,
          "?1" => 0n,
          "?2" => "new",
        }
,
        "query": 
"INSERT INTO \`Unblock\`(\`id\`,\`unique\`,\`name\`,\`deleted\`) VALUES
(?,?,?,DEFAULT)"
,
        "type": 2,
      },
      {
        "parameters": 
Map {
          "?0" => 11n,
        }
,
        "query": 
"SELECT \`entity1\`.\`id\`,
	\`entity1\`.\`id\`,
	\`entity1\`.\`deleted\`
FROM \`Unblock\` AS \`entity1\`
WHERE (\`entity1\`.\`id\`=?)"
,
        "type": 1,
      },
    ],
    "_query": 
"INSERT INTO \`Unblock\`(\`id\`,\`unique\`,\`name\`,\`deleted\`) VALUES
(?,?,?,DEFAULT);

SELECT \`entity1\`.\`id\`,
	\`entity1\`.\`id\`,
	\`entity1\`.\`deleted\`
FROM \`Unblock\` AS \`entity1\`
WHERE (\`entity1\`.\`id\`=?)"
,
    "_type": 3,
  },
  {
    "parameters": Map {},
    "query": 
"DELETE \`entity2\`
FROM \`Unblock\` AS \`entity2\`
INNER JOIN (
	SELECT 10 AS \`id\`
) AS \`delete\` ON (\`entity2\`.\`id\`=\`delete\`.\`id\`)"
,
    "type": 2,
  },
]
`;

