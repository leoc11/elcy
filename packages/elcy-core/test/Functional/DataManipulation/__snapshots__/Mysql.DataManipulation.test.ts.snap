  {
    "parameters": 
Map {
      "?0" => 100,
      "?1" => 99.99,
      "?2" => 99.99,
      "?3" => 50,
      "?4" => 100,
    }
,
    "query": 
"UPDATE \`fixture\`.\`Table1s\` AS \`entity0\`
INNER JOIN (
	SELECT \`entity0\`.\`id\`
	FROM \`fixture\`.\`Table1s\` AS \`entity0\`
	WHERE ((\`entity0\`.\`deleted\`=false) AND (\`entity0\`.\`integer\`>?) AND (\`entity0\`.\`real\`<=>?) AND ((COALESCE(\`entity0\`.\`real\`, 0))=?))
	ORDER BY \`entity0\`.\`id\`
	LIMIT ? OFFSET ?
) AS \`entity0_1\` ON (\`entity0\`.\`id\`=\`entity0_1\`.\`id\`)
SET \`entity0\`.\`deleted\` = true,
	\`entity0\`.\`modifiedDate\` = UTC_TIMESTAMP()"
,
    "type": 2,
  },
]
`;

