"UPDATE entity0
SET [entity0].[string] = @param4,
	[entity0].[real] = ([entity0].[real]+@param5)
FROM [Table1s] AS [entity0]
INNER JOIN (
	SELECT [entity0].[id]
	FROM [fixture].[Table1s] AS [entity0]
	WHERE (([entity0].[deleted]=0) AND ([entity0].[integer]>@param0) AND ([entity0].[real] IS NOT DISTINCT FROM @param1) AND ((COALESCE([entity0].[real], 0))=@param1))
	ORDER BY [entity0].[id]
	OFFSET @param2 ROWS
	FETCH NEXT @param3 ROWS ONLY
) AS [entity0_1] ON ([entity0].[id]=[entity0_1].[id])"
,
    "type": 2,
  },
]
`;

