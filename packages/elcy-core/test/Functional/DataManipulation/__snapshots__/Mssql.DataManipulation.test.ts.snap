exports[`Mssql DATA MANIPULATION UPDATE should do upsert 1`] = `
[
  BatchedQuery {
    "_isProcessed": true,
    "_parameters": Map {},
    "_queries": [
      {
        "query": "DROP TABLE IF EXISTS [#param0]",
        "type": 36,
      },
      {
        "query": 
"CREATE TABLE [#param0]
(
	[id] bigint,
	[bigint] bigint,
	[binary] varbinary,
	[boolean] bit,
	[date] datetime2,
	[plainDate] date,
	[dateTime] datetime2,
	[instant] datetime2,
	[decimal] nvarchar(255),
	[decimalNumber] real,
	[decimalDecimal] decimal(18, 6),
	[deleted] bit,
	[identifier] uniqueidentifier,
	[identifierString] nvarchar(255),
	[integer] real,
	[real] real,
	[string] nvarchar(255),
	[time] time,
	[plainTime] time,
	[modifiedDate] datetime2
)"
,
        "type": 36,
      },
      {
        "parameters": Map {},
        "query": 
"INSERT INTO [#param0]([id], [bigint], [binary], [boolean], [date], [plainDate], [dateTime], [instant], [decimal], [decimalNumber], [decimalDecimal], [deleted], [identifier], [identifierString], [integer], [real], [string], [time], [plainTime], [modifiedDate])
VALUES
	(NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,11,NULL,'Updated',NULL,NULL,NULL)"
,
        "type": 34,
      },
      {
        "parameters": Map {},
        "query": 
"UPDATE [entity0] WITH (UPDLOCK, HOLDLOCK)
SET [modifiedDate] = getutcdate(),
	[string] = [upsert].[string]
OUTPUT [INSERTED].[id],[INSERTED].[computed] AS [computed],[INSERTED].[createdDate],[INSERTED].[modifiedDate],[INSERTED].[deleted],[INSERTED].[integer]
FROM [Table1s] AS [entity0]
JOIN [#param0] AS [upsert] ON ([id]=[id])"
,
        "type": 3,
      },
      {
        "parameters": Map {},
        "query": 
"INSERT INTO [fixture].[Table1s] ([bigint],[binary],[boolean],[date],[plainDate],[dateTime],[instant],[decimal],[decimalNumber],[decimalDecimal],[deleted],[identifier],[identifierString],[integer],[real],[string],[time],[plainTime])
OUTPUT [INSERTED].[id],[INSERTED].[computed] AS [computed],[INSERTED].[createdDate],[INSERTED].[modifiedDate],[INSERTED].[deleted],[INSERTED].[integer]
SELECT [upsert].[id],
	[upsert].[bigint],
	[upsert].[binary],
	[upsert].[boolean],
	[upsert].[date],
	[upsert].[plainDate],
	[upsert].[dateTime],
	[upsert].[instant],
	[upsert].[decimal],
	[upsert].[decimalNumber],
	[upsert].[decimalDecimal],
	[upsert].[deleted],
	[upsert].[identifier],
	[upsert].[identifierString],
	[upsert].[integer],
	[upsert].[real],
	[upsert].[string],
	[upsert].[time],
	[upsert].[plainTime]
