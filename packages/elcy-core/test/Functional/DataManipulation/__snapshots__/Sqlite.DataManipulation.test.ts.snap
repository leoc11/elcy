exports[`Sqlite DATA MANIPULATION DELETE should delete entity (hard delete) 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"DELETE FROM "fixture"."Table1s" AS "entity0"
WHERE EXISTS(
	SELECT "entity0_1"."id"
	FROM (
		SELECT "entity0"."id",
			"entity0"."bigint",
			"entity0"."binary",
			"entity0"."boolean",
			"entity0"."date",
			"entity0"."plainDate",
			"entity0"."dateTime",
			"entity0"."instant",
			"entity0"."decimal",
			"entity0"."decimalNumber",
			"entity0"."decimalDecimal",
			"entity0"."deleted",
			"entity0"."identifier",
			"entity0"."identifierString",
			"entity0"."integer",
			"entity0"."real",
			"entity0"."string",
			"entity0"."time",
			"entity0"."plainTime",
			"entity0"."createdDate",
			"entity0"."modifiedDate"
		FROM "fixture"."Table1s" AS "entity0"
		INNER JOIN (
			SELECT
				column1 AS "id"
			FROM (
				VALUES
				(1)
			)
		) AS "delete" ON ("entity0"."id"="delete"."id")
	) AS "entity0_1"
	WHERE ("entity0_1"."id"="entity0"."id")
)"
,
    "type": 2,
  },
]
`;

