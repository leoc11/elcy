exports[`Sqlite DATA MANIPULATION UPDATE should do upsert 1`] = `
[
  {
    "parameters": 
Map {
      ":param0" => 11,
      ":param1" => "Updated",
    }
,
    "query": 
"INSERT INTO "fixture"."Table1s" AS "entity0"("bigint","binary","boolean","date","plainDate","dateTime","instant","decimal","decimalNumber","decimalDecimal","deleted","identifier","identifierString","integer","real","string","time","plainTime") VALUES
	(DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,:param0,DEFAULT,:param1,DEFAULT,DEFAULT)ON CONFLICT (id) DO UPDATE
SET "modifiedDate" = STRFTIME('%Y-%m-%d %H:%M:%f', 'NOW'),
	"string" = EXCLUDED."string"
RETURNING "entity0"."id","entity0"."computed" AS "computed","entity0"."createdDate","entity0"."modifiedDate","entity0"."deleted","entity0"."integer""
,
    "type": 3,
  },
]
`;

