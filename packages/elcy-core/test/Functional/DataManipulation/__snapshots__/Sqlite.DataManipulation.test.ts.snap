exports[`Sqlite DATA MANIPULATION UPDATE should bulk update entity with paging 1`] = `
[
  {
    "parameters": 
Map {
      ":param0" => 100,
      ":param1" => 99.99,
      ":param2" => 100,
      ":param3" => 50,
      ":param4" => 100.12,
    }
,
    "query": 
"UPDATE "fixture"."Table1s" AS "entity0"
SET "id" = "entity0_1"."id"
FROM (
	SELECT "entity0_1"."id"
	FROM (
		SELECT "entity0"."id"
		FROM "fixture"."Table1s" AS "entity0"
		WHERE (("entity0"."deleted"=false) AND ("entity0"."integer">:param0) AND ("entity0"."real" IS :param1) AND ((COALESCE("entity0"."real", 0))=:param1))
		LIMIT :param3
		OFFSET :param2
	) AS "entity0_1"
) AS "entity0_1"
WHERE ("id"="id")"
,
    "type": 2,
  },
]
`;

