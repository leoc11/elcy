exports[`Postgresql DATA MANIPULATION DELETE should bulk delete entity (soft delete) with paging 1`] = `
[
  {
    "parameters": 
Map {
      "$1" => 100,
      "$2" => 99.99,
      "$3" => 100,
      "$4" => 50,
    }
,
    "query": 
"UPDATE "fixture"."Table1s" AS "entity0"
SET "deleted" = true,
	"modifiedDate" = CURRENT_TIMESTAMP AT TIME ZONE 'UTC'
FROM (
	SELECT "entity0"."id"
	FROM "fixture"."Table1s" AS "entity0"
	WHERE (("entity0"."deleted"=false) AND ("entity0"."integer">$1) AND ("entity0"."real" IS NOT DISTINCT FROM $2) AND ((COALESCE("entity0"."real", 0))=$2))
	ORDER BY "entity0"."id"
	OFFSET $3 ROWS
	FETCH NEXT $4 ROWS ONLY
) AS "entity0_1"
WHERE ("entity0"."id"="entity0_1"."id")"
,
    "type": 2,
  },
]
`;

