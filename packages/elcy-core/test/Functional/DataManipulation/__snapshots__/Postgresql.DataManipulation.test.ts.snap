exports[`Postgresql DATA MANIPULATION SAVE should unblock insert unique constraint hard delete: set null 1`] = `
[
  {
    "parameters": Map {},
    "query": 
"UPDATE "Unblock" AS "entity0"
SET "unique" = (
	CASE WHEN ((("update"."__flag"&1)=0)) 
	THEN "entity0"."unique"
	ELSE "update"."unique"
	END
)
FROM (
	VALUES
	(10, NULL, 1)
) AS "update"("_ori_id", "unique", "__flag")
WHERE ("entity0"."id"="update"."_ori_id")"
,
    "type": 2,
  },
  {
    "parameters": 
Map {
      "$1" => 11n,
      "$2" => 0n,
      "$3" => "new",
    }
,
    "query": 
"INSERT INTO "Unblock" AS "entity1"("id","unique","name","deleted") VALUES
	($1,$2,$3,DEFAULT)
RETURNING "entity1"."id","entity1"."deleted""
,
    "type": 3,
  },
  {
    "parameters": Map {},
    "query": 
"DELETE FROM "Unblock" AS "entity2"
USING (
	VALUES
	(10)
) AS "delete"("id")
WHERE ("entity2"."id"="delete"."id")"
,
    "type": 2,
  },
]
`;

