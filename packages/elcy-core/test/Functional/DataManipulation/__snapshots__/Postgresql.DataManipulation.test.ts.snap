SET "deleted" = true,
	"modifiedDate" = CURRENT_TIMESTAMP AT TIME ZONE 'UTC'
FROM pg_temp."delete" AS "delete"
WHERE ("entity0"."id"="delete"."id") AND ("entity0"."deleted"=false)"
,
        "type": 2,
      },
      {
        "parameters": Map {},
        "query": 
"UPDATE "Table1Manies" AS "entity1"
SET "deleted" = true
FROM (
	SELECT "entity0"."id"
	FROM "fixture"."Table1s" AS "entity0"
	INNER JOIN pg_temp."delete" AS "delete" ON ("entity0"."id"="delete"."id")
	WHERE ("entity0"."deleted"=false)
) AS "entity0"
WHERE ("entity0"."id"="entity1"."table1Id") AND ("entity1"."deleted"=false)"
,
        "type": 2,
      },
    ],
    "_query": 
"DROP TABLE IF EXISTS pg_temp."delete";

CREATE TEMPORARY TABLE pg_temp."delete"
(
