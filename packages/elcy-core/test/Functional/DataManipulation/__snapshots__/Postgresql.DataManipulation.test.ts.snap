RETURNING "entity0"."id","entity0"."table1Id","entity0"."deleted""
,
        "type": 3,
      },
    ],
    "_query": 
"INSERT INTO "Table1Manies" AS "entity0"("table1Id","name","integer","deleted") VALUES
