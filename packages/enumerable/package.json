{
  "name": "@elcy/enumerable",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:js.min && bun run build:type",
    "build:js": "bun build src/index.ts --outdir dist --sourcemap=linked --target=node --format=esm --entry-naming=[dir]/[name].js",
    "build:js.min": "bun build src/index.ts --outdir dist --sourcemap=linked --target=node --format=esm --minify --entry-naming=[dir]/[name].js",
    "build:type": "bun tsc --emitDeclarationOnly --skipLibCheck --outdir dist",
    "test": "bun run test:unit && bun run test:type",
    "test:unit": "bun test ./test --reporter=dots --coverage",
    "test:type": "bun test --include ./test/*.test-d.ts --reporter=dots",
    "test:watch": "bun test --include ./test/*.{test-d,test}.ts --watch",
    "check": "bun run check:tsc && bun run check:lint && bun run check:fmt",
    "check:tsc": "bun tsc --noEmit --skipLibCheck",
    "check:lint": "bun eslint ./src --fix",
    "check:fmt": "prettier --check './*.{mjs,js,ts,md,json,html}' './{src,test}/{,**/}*.{mjs,js,ts,md,json,html}'",
    "gen": "bun run gen:index && bun run gen:fmt",
    "gen:index": "bun ./scripts/generate-index.ts ./src",
    "gen:fmt": "prettier --write './*.{mjs,js,ts,md,json,html}' './{src,test}/{,**/}*.{mjs,js,ts,md,json,html}'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  }
}
