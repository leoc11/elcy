{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "dist",
        "baseUrl": ".", // important for paths
        "paths": {
            "@elcy/enumerable": [
                "../enumerable/src"
            ] // map the package name to source folder
        }
    },
    "include": [
        "test",
        "src",
        "app.ts"
    ],
    "exclude": [
        "build",
        "node_modules",
        "**/node_modules/*"
    ]
}